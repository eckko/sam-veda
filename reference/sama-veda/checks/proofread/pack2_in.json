[
 {
  "id": "04.01.696a",
  "kind": "sample",
  "line": "अस्येदिन्द्रो मदेष्वा ग्राभं गृभ्णाति सानसिम् ।",
  "before": "सोमो जैत्रस्य चेतति यथा विदे ॥",
  "after": "वज्रं च वृषणं भरत्समप्सुजित् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.01.703a",
  "kind": "sample",
  "line": "यज्ञायज्ञा वो अग्नये गिरागिरा च दक्षसे ।",
  "before": "अभी ऋतस्य दोहना अनूषताधि त्रिपृष्ठ उषसो वि राजसि ॥",
  "after": "प्रप्र वयममृतं जातवेदसं प्रियं मित्रं न शँसिषम् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.02.747b",
  "kind": "sample",
  "line": "सुपारः सुश्रवस्तमः समप्सुजित् ॥",
  "before": "स प्रथमे व्योमनि देवानाँ सदने वृधः ।",
  "after": "तमु हुवे वाजसातय इन्द्रं भराय शुष्मिणम् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.02.759b",
  "kind": "sample",
  "line": "कविर्विप्रेण वावृधे ॥",
  "before": "एष प्रत्नेन मन्मना देवो देवेभ्यस्परि ।",
  "after": "दुहानः प्रत्नमित्पयः पवित्रे परि षिच्यसे ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.02.769b",
  "kind": "sample",
  "line": "सुता विदथे अक्रमुः ॥",
  "before": "प्र सोमासो मदच्युतः श्रवसे नो मघोनाम् ।",
  "after": "आदीँ हँसो यथा गणं विश्वस्यावीवशन्मतिम् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.03.790a",
  "kind": "sample",
  "line": "अग्निं दूतं वृणीमहे होतारं विश्ववेदसम् ।",
  "before": "ईशानः सोम विश्वतः ॥",
  "after": "अस्य यज्ञस्य सुक्रतुम् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.03.794b",
  "kind": "sample",
  "line": "ता मित्रावरुणा हुवे ॥",
  "before": "ऋतेन यावृतावृधावृतस्य ज्योतिषस्पती ।",
  "after": "वरुणः प्राविता भुवन्मित्रो विश्वाभिरूतिभिः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.03.801a",
  "kind": "sample",
  "line": "ता हि शश्वन्त ईडत इत्था विप्रास ऊतये ।",
  "before": "धिया धेना अवस्यवः ॥",
  "after": "सबाधो वाजसातये ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.04.845a",
  "kind": "sample",
  "line": "यस्त्वामग्ने हविष्पतिर्दूतं देव सपर्यति ।",
  "before": "हव्यवाड्जुह्वास्यः ॥",
  "after": "तस्य स्म प्राविता भव ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.04.845b",
  "kind": "sample",
  "line": "तस्य स्म प्राविता भव ॥",
  "before": "यस्त्वामग्ने हविष्पतिर्दूतं देव सपर्यति ।",
  "after": "यो अग्निं देववीतये हविष्माँ आविवासति ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.04.866b",
  "kind": "sample",
  "line": "पिशङ्गरूपं मघवन्विचर्षणे मक्षू गोमन्तमीमहे ॥",
  "before": "कण्वेभिर्धृष्णवा धृषद्वाजं दर्षि सहस्रिणम् ।",
  "after": "तरणिरित्सिषासति वाजं पुरन्ध्या युजा ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.911b",
  "kind": "sample",
  "line": "सहस्रस्थूण आशाते ॥",
  "before": "राजानावनभिद्रुहा ध्रुवे सदस्युत्तमे ।",
  "after": "ता सम्राजा घृतासुती आदित्या दानुनस्पती ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.921a",
  "kind": "sample",
  "line": "पवमान धिया हितो३ऽभि योनिं कनिक्रदत् ।",
  "before": "पवमानो अदाभ्यः ॥",
  "after": "धर्मणा वायुमारुहः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.922a",
  "kind": "sample",
  "line": "तवाहँ सोम रारण सख्य इन्दो दिवेदिवे ।",
  "before": "धर्मणा वायुमारुहः ॥",
  "after": "पुरूणि बभ्रो नि चरन्ति मामव परिधीँ रति ताँइहि ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.932a",
  "kind": "sample",
  "line": "समु रेभसो अस्वरन्निन्द्रँ सोमस्य पीतये ।",
  "before": "सुदीतयो वो अद्रुहोऽपि कर्णे तरस्विनः समृक्वभिः ॥",
  "after": "स्वःपतिर्यदी वृधे धृतव्रतो ह्योजसा समूतिभिः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.938b",
  "kind": "sample",
  "line": "अमृतत्वाय घोषयन् ॥",
  "before": "त्वँ ह्या३ँङ्ग दैव्या पवमान जनिमानि द्युमत्तमः ।",
  "after": "येना नवग्वो दध्यङ्ङपोर्णुते येन विप्रास आपिरे ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.946a",
  "kind": "sample",
  "line": "अग्निं वो वृधन्तमध्वराणां पुरूतमम् ।",
  "before": "अन्तः पश्यन्वृजनेमावराण्या तिष्ठति वृषभो गोषु जानन् ॥",
  "after": "अच्छा नप्त्रे सहस्वते ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.948a",
  "kind": "sample",
  "line": "अयं विश्वा अभि श्रियोऽग्निर्देवेषु पत्यते ।",
  "before": "अस्य क्रत्वा यशस्वतः ॥",
  "after": "आ वाजैरुप नो गमत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.952a",
  "kind": "sample",
  "line": "इन्द्र जुषस्व प्र वहा याहि शूर हरिह ।",
  "before": "सुता अमत्सुरिन्दवो ज्येष्ठं नमस्यता सहः ॥",
  "after": "पिबा सुतस्य मतिर्न मधोश्चकानश्चारुर्मदाय ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.965b",
  "kind": "sample",
  "line": "सस्निर्यो अनुमाद्यः ॥",
  "before": "त्वँ सोम नृमादनः पवस्व चर्षणीधृतिः ।",
  "after": "पवस्व वृत्रहन्तम उक्थेभिरनुमाद्यः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.983b",
  "kind": "sample",
  "line": "आ ते यतन्ते रथ्यो३ यथा पृथक्षर्धाँस्यग्ने अजरस्य धक्षतः ॥",
  "before": "वातोपजूत इषितो वशाँ अनु तृषु यदन्ना वेविषद्वितिष्ठसे ।",
  "after": "मेधाकारं विदथस्य प्रसाधनमग्निँ होतारं परिभूतरं मतिम् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.995a",
  "kind": "sample",
  "line": "अप्सा इन्द्राय वायवे वरुणाय मरुद्भ्यः ।",
  "before": "सीदन्योनौ योनेष्वा ॥",
  "after": "सोमा अर्षन्तु विष्णवे ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.995b",
  "kind": "sample",
  "line": "सोमा अर्षन्तु विष्णवे ॥",
  "before": "अप्सा इन्द्राय वायवे वरुणाय मरुद्भ्यः ।",
  "after": "इषं तोकाय नो दधदस्मभ्यँ सोम विश्वतः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.1003a",
  "kind": "sample",
  "line": "असि हि वीर सेन्योऽसि भूरि पराददिः ।",
  "before": "तमिन्महत्स्वाजिषूतिमर्भे हवामहे स वाजेषु प्र नोऽविषत् ॥",
  "after": "असि दभ्रस्य चिद्वृधो यजमानाय शिक्षसि सुन्वते भूरि ते वसु ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.1007a",
  "kind": "sample",
  "line": "ता अस्य नमसा सहः सपर्यन्ति प्रचेतसः ।",
  "before": "प्रिया इन्द्रस्य धेनवो वज्रँ हिन्वन्ति सायकं वस्वीरनु स्वराज्यम् ॥",
  "after": "व्रतान्यस्य सश्चिरे पुरूणि पूर्वचित्तये वस्वीरनु स्वराज्यम् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.1007b",
  "kind": "sample",
  "line": "व्रतान्यस्य सश्चिरे पुरूणि पूर्वचित्तये वस्वीरनु स्वराज्यम् ॥",
  "before": "ता अस्य नमसा सहः सपर्यन्ति प्रचेतसः ।",
  "after": "असाव्यँशुर्मदायाप्सु दक्षो गिरिष्ठाः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.07.1031b",
  "kind": "sample",
  "line": "दधाति रत्नँ स्वधयोरपीच्यं मदिन्तमो मत्सर इन्द्रियो रसः ॥",
  "before": "ज्योतिर्यज्ञस्य पवते मधु प्रियं पिता देवानां जनिता विभूवसुः ।",
  "after": "अभिक्रन्दन्कलशं वाज्यर्षति पतिर्दिवः शतधारो विचक्षणः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.07.1039b",
  "kind": "sample",
  "line": "अपो वसिष्ट सुक्रतुः ॥",
  "before": "अधुक्षत प्रियं मधु धारा सुतस्य वेधसः ।",
  "after": "महान्तं त्वा महीरन्वापो अर्षन्ति सिन्धवः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.07.1040b",
  "kind": "sample",
  "line": "यद्गोभिर्वासयिष्यसे ॥",
  "before": "महान्तं त्वा महीरन्वापो अर्षन्ति सिन्धवः ।",
  "after": "समुद्रो अप्सु मामृजे विष्टम्भो धरुणो दिवः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.07.1049b",
  "kind": "sample",
  "line": "अथा नो वस्यसस्कृधि ॥",
  "before": "सना दक्षमुत क्रतुमप सोम मृधो जहि ।",
  "after": "पवीतारः पुनीतन सोममिन्द्राय पातवे ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.07.1053a",
  "kind": "sample",
  "line": "अभ्यर्ष स्वायुध सोम द्विबर्हसँ रयिम् ।",
  "before": "अथा नो वस्यसस्कृधि ॥",
  "after": "अथा नो वस्यसस्कृधि ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.07.1072a",
  "kind": "sample",
  "line": "यद्वीडाविन्द्र यत्स्थिरे यत्पर्शाने पराभृतम् ।",
  "before": "वसु स्पार्हं तदा भर ॥",
  "after": "वसु स्पार्हं तदा भर ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.1120a",
  "kind": "sample",
  "line": "हिन्वानासो रथा इव दधन्विरे गभस्त्योः ।",
  "before": "सोमासो राये अक्रमुः ॥",
  "after": "भरासः कारिणामिव ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.1124b",
  "kind": "sample",
  "line": "वृष्णो हरस आयवः ॥",
  "before": "अप द्वारा मतीनां प्रत्ना ऋण्वन्ति कारवः ।",
  "after": "समीचीनास आशत होतारः सप्तजानयः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.1127b",
  "kind": "sample",
  "line": "सूरः पस्यति चक्षसा ॥",
  "before": "अभि प्रियं दिवस्पदमध्वर्युभिर्गुहा हितम् ।",
  "after": "असृग्रमिन्दवः पथा धर्मन्नृतस्य सुश्रियः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.1148a",
  "kind": "sample",
  "line": "इन्द्रा याहि तूतुजान उप ब्रह्माणि हरिवः ।",
  "before": "उप ब्रह्माणि वाघतः ॥",
  "after": "सुते दधिष्व नश्चनः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.1153a",
  "kind": "sample",
  "line": "प्र वो धियो मन्द्रयुवो विपन्युवः पनस्युवः संवरणेष्वक्रमुः ।",
  "before": "मर्य इव युवतिभिः समर्षति सोमः कलशे शतयाम्ना पथा ॥",
  "after": "हरिं क्रीडन्तमभ्यनूषत स्तुभोऽभि धेनवः पयसेदशिश्रयुः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.1165a",
  "kind": "sample",
  "line": "ते नो वृष्टिं दिवस्परि पवन्तामा सुवीर्यम् ।",
  "before": "ये वा जनेषु पञ्चसु ॥",
  "after": "स्वाना देवास इन्दवः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.09.1177b",
  "kind": "sample",
  "line": "अपामूर्मिँ सचमानः समुद्रं तुरीयं धाम महिषो विवक्ति ॥",
  "before": "चमूषच्छ्येनः शकुनो विभृत्वा गोविन्दुर्द्रप्स आयुधानि बिभ्रत् ।",
  "after": "एते सोमा अभि प्रियमिन्द्रस्य काममक्षरन् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.09.1205a",
  "kind": "sample",
  "line": "उत्ते शुष्मास ईरते सिन्धोरूर्मेरिव स्वनः ।",
  "before": "सोमो हिन्वे परावति ॥",
  "after": "वाणस्य चोदया पविम् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.09.1219a",
  "kind": "sample",
  "line": "अग्निं वो देवमग्निभिः सजोषा यजिष्ठं दूतमध्वरे कृणुध्वम् ।",
  "before": "इन्दुरिन्द्र इति ब्रुवन् ॥",
  "after": "यो मर्त्येषु निध्रुविरृतावा तपुर्मूर्धा घृतान्नः पावकः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.09.1220a",
  "kind": "sample",
  "line": "प्रोथदश्वो न यवसेऽविष्यन्यदा महः संवरणाद्व्यस्थात् ।",
  "before": "यो मर्त्येषु निध्रुविरृतावा तपुर्मूर्धा घृतान्नः पावकः ॥",
  "after": "आदस्य वातो अनु वाति शोचिरध स्म ते व्रजनं कृष्णमस्ति ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.09.1251a",
  "kind": "sample",
  "line": "त्वं वलस्य गोमतोऽपावरद्रिवो बिलम् ।",
  "before": "इन्द्रो विश्वस्य कर्मणो धर्त्ता वज्री पुरुष्टुतः ॥",
  "after": "त्वां देवा अबिभ्युषस्तुज्यमानास आविषुः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1261a",
  "kind": "sample",
  "line": "एष देवो विपा कृतोऽति ह्वराँसि धावति ।",
  "before": "हरिर्वाजाय मृज्यते ॥",
  "after": "पवमानो अदाभ्यः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1261b",
  "kind": "sample",
  "line": "पवमानो अदाभ्यः ॥",
  "before": "एष देवो विपा कृतोऽति ह्वराँसि धावति ।",
  "after": "एष दिवं वि धावति तिरो रजाँसि धारया ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1296b",
  "kind": "sample",
  "line": "सोमो वाजमिवासरत् ॥",
  "before": "स वृत्रहा वृषा सुतो वरिवोविददाभ्यः ।",
  "after": "स देवः कविनेषितो३ऽभि द्रोणानि धावति ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1315",
  "kind": "sample",
  "line": "परि स्वानश्चक्षसे देवमादनः क्रतुरिन्दुर्विचक्षणः ॥",
  "before": "सुते चित्वाप्सु मदामो अन्धसा श्रीणन्तो गोभिरुत्तरम् ॥",
  "after": "असावि सोमो अरुषो वृषा हरी राजेव दस्मो अभि गा अचिक्रदत् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1321b",
  "kind": "sample",
  "line": "मघवञ्छग्धि तव तन्न ऊतये वि द्विषो वि मृधो जहि ॥",
  "before": "यत इन्द्र भयामहे ततो नो अभ्यं कृधि ।",
  "after": "त्वँ हि राधस्पते राधसो महः क्षयस्यासि विध्रत्ता ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1330b",
  "kind": "sample",
  "line": "प्रियमिन्द्रस्य काम्यं प्रस्नापयन्त ऊर्मयः ॥",
  "before": "द्विर्यं पञ्च स्वयशसँ सखायो अद्रिसँहतम् ।",
  "after": "इन्द्राय सोम पातवे वृत्रघ्ने परि षिच्यसे ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1341a",
  "kind": "sample",
  "line": "य एक इद्विदयते वसु मर्त्ताय दाशुषे ।",
  "before": "येषामिन्द्रो युवा सखा ॥",
  "after": "ईशानो अप्रतिष्कुत इन्द्रो अङ्ग ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1342a",
  "kind": "sample",
  "line": "यश्चिद्धि त्वा बहुभ्य आ सुतावाँ आविवासति ।",
  "before": "ईशानो अप्रतिष्कुत इन्द्रो अङ्ग ॥",
  "after": "उग्रं तत्पत्यते शव इन्द्रो अङ्ग ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.10.1342b",
  "kind": "sample",
  "line": "उग्रं तत्पत्यते शव इन्द्रो अङ्ग ॥",
  "before": "यश्चिद्धि त्वा बहुभ्य आ सुतावाँ आविवासति ।",
  "after": "कदा मर्त्तमराधसं पदा क्षुम्पमिव स्फुरत् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.11.1347a",
  "kind": "sample",
  "line": "सुषमिद्धो न आ वह देवाँ अग्ने हविष्मते ।",
  "before": "अथा न इन्द्र सोमपा गिरामुपश्रुतिं चर ॥",
  "after": "होतः पावक यक्षि च ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.11.1362a",
  "kind": "sample",
  "line": "उदु त्ये मधुमत्तमा गिर स्तोमास ईरते ।",
  "before": "विद्वेषणँ संवननमुभयङ्करं मँहिष्ठमुभयाविनम् ॥",
  "after": "सत्राजितो धनसा अक्षितोतयो वाजन्तो रथा इव ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.11.1363a",
  "kind": "sample",
  "line": "कण्वा इव भृगवः सूर्या इव विश्वमिद्धीतमाशत ।",
  "before": "सत्राजितो धनसा अक्षितोतयो वाजन्तो रथा इव ॥",
  "after": "इन्द्रँ स्तोमेभिर्महयन्त आयवः प्रियमेधासो अस्वरन् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.12.1388a",
  "kind": "sample",
  "line": "स वीरो दक्षसाधनो वि यस्तस्तम्भ रोदसी ।",
  "before": "सरज्जारो न योषणां वरो न योनिमासदम् ॥",
  "after": "हरिः पवित्रे अव्यत वेधा न योनिमासदम् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.12.1396b",
  "kind": "sample",
  "line": "समिद्धः शुक्र आहुतः ॥",
  "before": "अग्निर्वृत्राणि जङ्घनद्द्रविणस्युर्विपन्यया ।",
  "after": "गर्भे मातुः पितुष्पिता विदिद्युतानो अक्षरे ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.12.1416b",
  "kind": "sample",
  "line": "वाजो अस्ति श्रवाय्यः ॥",
  "before": "न किरस्य सहन्त्य पर्येता कयस्य चित् ।",
  "after": "स वाजं विश्वचर्षणिरर्वद्भिरस्तु तरुता ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.13.1440a",
  "kind": "sample",
  "line": "प्रत्यस्मै पिपीषते विश्वानि विदुषे भर ।",
  "before": "प्रत्नवद्रोचयन्रुचः ॥",
  "after": "अरङ्गमाय जग्मयेऽपश्चादध्वने नरः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.13.1442b",
  "kind": "sample",
  "line": "वेदा विश्वस्य मेधिरो धृषत्तन्तमिदेषते ॥",
  "before": "यदी सुतेभिरिन्दुभिः सोमेभिः प्रतिभूषथ ।",
  "after": "अस्मास्मा इदन्धसोऽध्वर्यो प्र भरा सुतम् ।",
  "note": "ordinary line, no flag"
 }
]