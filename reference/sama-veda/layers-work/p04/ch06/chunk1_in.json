  ],
  "lines_iast": [
   "govitpavasva vasuviddhiraṇyavidretodhā indo bhuvaneṣvarpitaḥ",
   "tva~ suvīro asi soma viśvavittaṃ tvā nara upa girema āsate"
  ],
