  "lines_deva": [
   "ऋतस्य जिह्वा पवते मधु प्रियं वक्ता पतिर्धियो अस्या अदाभ्यः",
   "दधाति पुत्रः पित्रोरपीच्या३ं नाम तृतीयमधि रोचनं दिवः"
  ],
  "lines_iast": [
   "ṛtasya jihvā pavate madhu priyaṃ vaktā patirdhiyo asyā adābhyaḥ",
   "dadhāti putraḥ pitrorapīcyā3ṃ nāma tṛtīyamadhi rocanaṃ divaḥ"
  ],
