   "04.03.829a",
   "04.03.829b"
  ],
  "lines_deva": [
   "पूर्वीरिन्द्रस्य रातयो न वि दस्यन्त्यूतयः",
   "यदा वाजस्य गोमत स्तोतृभ्यो मँहते मघम्"
  ],
  "lines_iast": [
   "pūrvīrindrasya rātayo na vi dasyantyūtayaḥ",
   "yadā vājasya gomata stotṛbhyo ma~hate magham"
  ],
