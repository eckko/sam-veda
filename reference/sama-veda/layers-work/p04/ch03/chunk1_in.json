   "04.03.825b"
  ],
  "lines_deva": [
   "एवा रातिस्तुवीमघ विश्वेभिर्धायि धातृभिः",
   "अधा चिदिन्द्र नः सचा"
  ],
  "lines_iast": [
   "evā rātistuvīmagha viśvebhirdhāyi dhātṛbhiḥ",
   "adhā cidindra naḥ sacā"
  ],
