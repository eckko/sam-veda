  "type": "verse",
  "line_ids": [
   "04.03.826a",
   "04.03.826b"
  ],
  "lines_deva": [
   "मो षु ब्रह्मेव तदिन्द्रयुर्भुवो वाजानां पते",
   "मत्स्वा सुतस्य गोमतः"
  ],
  "lines_iast": [
   "mo ṣu brahmeva tadindrayurbhuvo vājānāṃ pate",
   "matsvā sutasya gomataḥ"
  ],
