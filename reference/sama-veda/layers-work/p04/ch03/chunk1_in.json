  "type": "verse",
  "line_ids": [
   "04.03.828a",
   "04.03.828b"
  ],
  "lines_deva": [
   "सख्ये त इन्द्र वाजिनो मा भेम शवसस्पते",
   "त्वामभि प्र नोनुमो जेतारमपराजितम्"
  ],
  "lines_iast": [
   "sakhye ta indra vājino mā bhema śavasaspate",
   "tvāmabhi pra nonumo jetāramaparājitam"
  ],
