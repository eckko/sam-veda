   "04.03.827b"
  ],
  "lines_deva": [
   "इन्द्रं विश्वा अवीवृधन्त्समुद्रव्यचसं गिरः",
   "रथीतमँ रथीनां वाजानाँ सत्पतिं पतिम्"
  ],
  "lines_iast": [
   "indraṃ viśvā avīvṛdhantsamudravyacasaṃ giraḥ",
   "rathītama~ rathīnāṃ vājānā~ satpatiṃ patim"
  ],
