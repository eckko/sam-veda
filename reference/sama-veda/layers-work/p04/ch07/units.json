  "lines_deva": [
   "ज्योतिर्यज्ञस्य पवते मधु प्रियं पिता देवानां जनिता विभूवसुः",
   "दधाति रत्नँ स्वधयोरपीच्यं मदिन्तमो मत्सर इन्द्रियो रसः"
  ],
  "lines_iast": [
   "jyotiryajñasya pavate madhu priyaṃ pitā devānāṃ janitā vibhūvasuḥ",
   "dadhāti ratna~ svadhayorapīcyaṃ madintamo matsara indriyo rasaḥ"
  ],
