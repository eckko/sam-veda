  ],
  "lines_deva": [
   "एवा हि शक्रो राये वाजाय वज्रिवः",
   "शविष्ठ वज्रिन्नृञ्जसे मँहिष्ठ वज्रिन्नृञ्जस",
   "आ याहि पिब मत्स्व"
  ],
  "lines_iast": [
   "evā hi śakro rāye vājāya vajrivaḥ",
   "śaviṣṭha vajrinnṛñjase ma~hiṣṭha vajrinnṛñjasa",
   "ā yāhi piba matsva"
  ],
