  "lines_deva": [
   "विदा राये सुवीर्यं भवो वाजानां पतिर्वशाँ अनु",
   "मँहिष्ठ वज्रिन्नृञ्जसे यः शविष्ठः शूराणाम्"
  ],
  "lines_iast": [
   "vidā rāye suvīryaṃ bhavo vājānāṃ patirvaśā~ anu",
